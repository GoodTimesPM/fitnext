{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/api/:route(.*)", "destination": "/api?route=:route" }],
  "functions": { "api/index.mjs": { "maxDuration": 30, "includeFiles": "server/**" } },
  "headers": [{ "source": "/sw.js", "headers": [{ "key": "cache-control", "value": "no-cache" }] }]
}
