# Copy to .env and fill in. Every key is optional: a missing one hides that source in the app.
# The proxy (npm run proxy) reads these; the browser never sees them.

# USDA FoodData Central, free: https://fdc.nal.usda.gov/api-key-signup  (DEMO_KEY works, 30 req/hour)
USDA_API_KEY=DEMO_KEY

# FatSecret Platform, Premier Free tier: https://platform.fatsecret.com/  (OAuth2 client credentials)
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=

# Edamam Food Database, free tier: https://developer.edamam.com/
EDAMAM_APP_ID=
EDAMAM_APP_KEY=

# Spoonacular recipes, free 50 points/day: https://spoonacular.com/food-api
SPOONACULAR_API_KEY=

# Google Gemini for photo logging and voice-text parsing, free tier in AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# TheMealDB recipes. "1" is the free test key; a supporter key unlocks the full API.
MEALDB_KEY=

# ---- built into the app (VITE_ prefix): these end up in the browser, so never put a secret here ----
# Where the phone apps and other builds reach the API, e.g. https://fitnext.vercel.app (blank: same origin)
VITE_API_BASE=
# Sync: Project URL and anon public key from Supabase > Project Settings > API (see README, "Sync")
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
